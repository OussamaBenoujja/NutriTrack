<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'NutriTrack - Weekly Reports', extraHead: '<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>' }) %>
<style>
        @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');
        
        body {
            font-family: 'Manrope', sans-serif;
            background: #f8fafc;
        }
        /* existing styles continue */
        
        .nav-link:hover {
            background: rgba(0, 150, 136, 0.1);
            color: #009688;
            transform: translateY(-1px);
        }
        
        .stats-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            transition: all 0.4s ease;
        }
        
        .stats-card:hover {
            box-shadow: 0 20px 40px rgba(0, 150, 136, 0.1);
        }
        
        .metric-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            transition: all 0.3s ease;
        }
        
        .metric-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0, 150, 136, 0.1);
        }
        
        .slide-in {
            animation: slideIn 0.6s ease-out;
        }
        
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .form-input {
            transition: all 0.3s ease;
            border: 1px solid #d1d5db;
        }
        
        .form-input:focus {
            border-color: #009688;
            box-shadow: 0 0 0 3px rgba(0, 150, 136, 0.1);
        }
        
        .chart-container {
            position: relative;
            height: 300px;
            margin: 1.5rem 0;
            background: rgba(255, 255, 255, 0.5);
            border-radius: 12px;
            padding: 1rem;
            backdrop-filter: blur(10px);
        }
        
        .empty-state {
            text-align: center;
            padding: 3rem 2rem;
            background: rgba(255, 255, 255, 0.5);
            border-radius: 20px;
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .empty-state-icon {
            width: 4rem;
            height: 4rem;
            background: linear-gradient(135deg, #f0fdfa, #ccfbf1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            color: #009688;
            font-size: 1.5rem;
        }
        
        .gradient-text {
            color: #009688;
        }
        
        .trend-up { color: #10b981; }
        .trend-down { color: #ef4444; }
        .trend-neutral { color: #6b7280; }
        
        /* Responsive Design */
        @media (max-width: 768px) {
            .hero-title {
                font-size: 2rem;
            }
            
            .card {
                padding: 1.5rem;
                margin-bottom: 1rem;
            }
            
            .metric-card {
                padding: 1rem;
            }
        }
        
  </style>
<body class="min-h-screen bg-gray-50">
    <%- include('../partials/navbar', { active: 'reports', user }) %>
    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Hero Section -->
        <section class="mb-12 slide-in">
            <div class="relative overflow-hidden rounded-2xl bg-teal-600 p-8 mb-8">
                <div class="absolute inset-0 bg-black/10"></div>
                <div class="relative z-10">
                    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
                        <div class="mb-6 lg:mb-0">
                            <h1 class="text-4xl font-bold text-white mb-3 flex items-center">
                                <i class="ri-bar-chart-line mr-4 text-4xl"></i>
                                Weekly Reports
                            </h1>
                            <p class="text-teal-100 text-lg mb-4">
                                Comprehensive weekly nutrition analysis and insights
                            </p>
                            <div class="flex items-center text-teal-200">
                                <i class="ri-calendar-line mr-2"></i>
                                <span class="font-mono text-lg">Track your progress</span>
                            </div>
                        </div>
                        
                        <!-- Quick Actions -->
                        <div class="flex flex-wrap gap-4">
                            <a href="/dashboard" class="btn-primary px-6 py-3 text-white font-semibold rounded-xl flex items-center shadow-lg">
                                <i class="ri-arrow-left-line mr-2"></i>Back to Dashboard
                            </a>
                        </div>
                    </div>
                </div>
                
                <!-- Decorative Elements -->
                <div class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full -translate-y-16 translate-x-16"></div>
                <div class="absolute bottom-0 left-0 w-24 h-24 bg-white/10 rounded-full translate-y-12 -translate-x-12"></div>
            </div>
        </section>

        <!-- Generate Report Card -->
        <div class="stats-card rounded-2xl shadow-xl p-8 mb-8 slide-in">
            <div class="flex items-center mb-6">
                <div class="w-12 h-12 bg-teal-600 rounded-xl flex items-center justify-center mr-4 shadow-lg">
                    <i class="ri-file-chart-line text-white text-xl"></i>
                </div>
                <div>
                    <h2 class="text-xl font-bold text-gray-800">Generate New Report</h2>
                    <p class="text-sm text-gray-600">Create a comprehensive weekly nutrition analysis</p>
                </div>
            </div>

            <form action="/reports/weekly/generate" method="post" class="space-y-6">
                <div>
                    <label for="week_start" class="block text-sm font-medium text-gray-700 mb-2 flex items-center">
                        <i class="ri-calendar-line mr-2 text-teal-600"></i>Week Start Date (Monday)
                    </label>
                    <div class="flex gap-4 items-end">
                        <div class="flex-1" style="flex: 0.7;">
                            <input type="date" id="week_start" name="week_start"
                                   class="form-input w-full p-3 rounded-lg border border-gray-300">
                            <p class="text-xs text-gray-500 mt-2 hidden">Leave blank to generate for current week</p>
                        </div>
                        <div class="flex-1" style="flex: 0.3;">
                            <button type="submit" class="btn-secondary flex items-center w-full justify-center px-6 py-3.5 text-white font-semibold rounded-xl">
                                <i class="ri-file-chart-line mr-2"></i>Generate Report
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <!-- Reports List -->
        <div class="stats-card rounded-2xl shadow-xl p-8 slide-in">
            <div class="flex items-center mb-6">
                <div class="w-12 h-12 bg-blue-600 rounded-xl flex items-center justify-center mr-4 shadow-lg">
                    <i class="ri-file-list-line text-white text-xl"></i>
                </div>
                <div>
                    <h2 class="text-xl font-bold text-gray-800">Previous Reports</h2>
                    <p class="text-sm text-gray-600">Your generated weekly nutrition summaries</p>
                </div>
            </div>

        <% if (Array.isArray(reports) && reports.length) { %>
                <div class="space-y-6">
                    <% reports.forEach(function(r, index){ %>
                        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden">
                            <!-- Report Header -->
                            <div class="px-6 py-4 border-b border-gray-100">
                                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
                                    <div class="flex items-center space-x-3 mb-3 lg:mb-0">
                                        <div class="bg-teal-100 text-teal-800 px-4 py-2 rounded-full text-sm font-semibold shadow-sm">
                                            <i class="ri-calendar-line mr-1"></i>Week <%= r.week_start_ymd %>
                                        </div>
                  <% if (r.created_at) { %>
                                        <div class="bg-gray-100 text-gray-700 px-4 py-2 rounded-full text-sm font-medium">
                                            <i class="ri-time-line mr-1"></i>Generated <%= new Date(r.created_at).toLocaleDateString() %>
                                        </div>
                  <% } %>
                                    </div>
                                    <div class="flex items-center space-x-2">
                                        <button onclick="toggleChart(<%= index %>)" class="btn-secondary px-4 py-2 text-white rounded-lg text-sm font-semibold transition-all duration-200 flex items-center">
                                            <i class="ri-bar-chart-line mr-1"></i>View Chart
                                        </button>
                                    </div>
                                </div>
                            </div>
                
                                <% if (r.summary_json || r._summary_object) { %>
                                    <% 
                                        let summary = r._summary_object;
                                        if (!summary) {
                                            try { summary = JSON.parse(r.summary_json); } catch(e) { summary = {}; }
                                        }
                                    %>
                                
                                <!-- Metrics Grid -->
                                <div class="p-6">
                                    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
                                        <div class="bg-teal-50 rounded-xl p-4 text-center border border-teal-200">
                                            <div class="w-8 h-8 bg-teal-100 rounded-lg flex items-center justify-center mx-auto mb-2">
                                                <i class="ri-fire-line text-teal-600 text-lg"></i>
                                            </div>
                                            <div class="text-lg font-bold text-teal-900"><%= Math.round(summary.avg_calories || 0) %></div>
                                            <div class="text-xs text-teal-600">Avg Calories</div>
                                        </div>
                                        
                                        <div class="bg-blue-50 rounded-xl p-4 text-center border border-blue-200">
                                            <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-2">
                                                <i class="ri-dumbbell-line text-blue-600 text-lg"></i>
                                            </div>
                                            <div class="text-lg font-bold text-blue-900"><%= Math.round(summary.avg_protein || summary.avg_proteins || 0) %>g</div>
                                            <div class="text-xs text-blue-600">Avg Protein</div>
                                        </div>
                                        
                                        <div class="bg-yellow-50 rounded-xl p-4 text-center border border-yellow-200">
                                            <div class="w-8 h-8 bg-yellow-100 rounded-lg flex items-center justify-center mx-auto mb-2">
                                                <i class="ri-wheat-line text-yellow-600 text-lg"></i>
                                            </div>
                                            <div class="text-lg font-bold text-yellow-900"><%= Math.round(summary.avg_carbs || 0) %>g</div>
                                            <div class="text-xs text-yellow-600">Avg Carbs</div>
                                        </div>
                                        
                                        <div class="bg-purple-50 rounded-xl p-4 text-center border border-purple-200">
                                            <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center mx-auto mb-2">
                                                <i class="ri-drop-line text-purple-600 text-lg"></i>
                                            </div>
                                            <div class="text-lg font-bold text-purple-900"><%= Math.round(summary.avg_fats || 0) %>g</div>
                                            <div class="text-xs text-purple-600">Avg Fats</div>
                                        </div>
                    <% if (summary.bmi) { %>
                                        <div class="bg-green-50 rounded-xl p-4 text-center border border-green-200">
                                            <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center mx-auto mb-2">
                                                <i class="ri-heart-line text-green-600 text-lg"></i>
                                            </div>
                                            <div class="text-lg font-bold text-green-900"><%= summary.bmi %></div>
                                            <div class="text-xs text-green-600">BMI</div>
                                        </div>
                                    <% } %>
                                    <% if (summary.sodium_alerts) { %>
                                        <div class="bg-red-50 rounded-xl p-4 text-center border border-red-200">
                                            <div class="w-8 h-8 bg-red-100 rounded-lg flex items-center justify-center mx-auto mb-2">
                                                <i class="ri-alert-line text-red-600 text-lg"></i>
                                            </div>
                                            <div class="text-lg font-bold text-red-900"><%= summary.sodium_alerts %></div>
                                            <div class="text-xs text-red-600">Sodium Alerts</div>
                                        </div>
                    <% } %>
                                    </div>
                                </div>
                                
                                <!-- Chart Data + Container (refactored) -->
                                <div class="chart-data hidden"
                                     data-week="<%= r.week_start_ymd %>"
                                     data-calories="<%= Math.round(summary.avg_calories || 0) %>"
                                     data-protein="<%= Math.round(summary.avg_protein || 0) %>"
                                     data-carbs="<%= Math.round(summary.avg_carbs || 0) %>"
                                     data-fats="<%= Math.round(summary.avg_fats || 0) %>"></div>
                                <div id="chart-<%= index %>" class="chart-container hidden">
                                    <canvas id="nutritionChart-<%= index %>"></canvas>
                                </div>
                                
                            <% } else { %>
                                <div class="text-center py-8 text-gray-500">
                                    <i class="ri-file-damage-line text-4xl mb-2"></i>
                                    <p>No summary data available for this report</p>
                                </div>
                <% } %>
              </div>
          <% }) %>
                </div>
        <% } else { %>
                <div class="text-center py-16">
                    <div class="w-20 h-20 bg-gradient-to-br from-teal-100 to-blue-100 rounded-full flex items-center justify-center mx-auto mb-6">
                        <i class="ri-file-chart-line text-teal-600 text-3xl"></i>
                    </div>
                    <h4 class="text-xl font-semibold text-gray-700 mb-3">No reports yet</h4>
                    <p class="text-gray-500 mb-8 max-w-md mx-auto">
                        Generate your first weekly report to start tracking your nutrition progress and insights.
                    </p>
                    <div class="flex flex-wrap gap-4 justify-center">
                        <div class="flex items-center gap-2 px-4 py-2 bg-teal-50 rounded-lg border border-teal-200">
                            <i class="ri-file-chart-line text-teal-600"></i>
                            <span class="text-sm font-medium text-teal-700">Weekly Analysis</span>
                        </div>
                        <div class="flex items-center gap-2 px-4 py-2 bg-blue-50 rounded-lg border border-blue-200">
                            <i class="ri-bar-chart-line text-blue-600"></i>
                            <span class="text-sm font-medium text-blue-700">Nutrition Insights</span>
                        </div>
                    </div>
                </div>
        <% } %>
    </div>
  </main>

    <script>
        function toggleChart(index) {
            const chartContainer = document.getElementById(`chart-${index}`);
            const button = event.target.closest('button');
            
            if (chartContainer.classList.contains('hidden')) {
                chartContainer.classList.remove('hidden');
                button.innerHTML = '<i class="ri-eye-off-line mr-1"></i>Hide Chart';
                
                // Create chart if not already created
                if (!window.charts || !window.charts[index]) {
                    createNutritionChart(index);
                }
            } else {
                chartContainer.classList.add('hidden');
                button.innerHTML = '<i class="ri-bar-chart-line mr-1"></i>View Chart';
            }
        }
        
        function createNutritionChart(index) {
            const ctx = document.getElementById(`nutritionChart-${index}`).getContext('2d');
            const data = window[`chartData${index}`];
            
            if (!window.charts) window.charts = {};
            
            window.charts[index] = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Protein', 'Carbs', 'Fats'],
                    datasets: [{
                        data: [data.protein, data.carbs, data.fats],
                        backgroundColor: [
                            '#3b82f6', // Blue for protein
                            '#eab308', // Yellow for carbs
                            '#8b5cf6'  // Purple for fats
                        ],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                padding: 20,
                                usePointStyle: true,
                                font: {
                                    family: 'Manrope',
                                    size: 12
                                }
                            }
                        },
                        title: {
                            display: true,
                            text: `Nutrition Breakdown - Week ${data.week}`,
                            font: {
                                family: 'Manrope',
                                size: 16,
                                weight: 'bold'
                            },
                            color: '#374151'
                        }
                    },
                    cutout: '60%',
                    animation: {
                        animateRotate: true,
                        animateScale: true,
                        duration: 1000
                    }
                }
            });
        }
        
        // Initialize charts for visible reports
        document.addEventListener('DOMContentLoaded', function() {
            // Add smooth scrolling for anchor links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });
        });
    </script>
    
    <!-- Toast Notification System -->
    <script src="/js/toast.js"></script>
    <script src="/js/toast-helpers.js"></script>
</body>
</html>