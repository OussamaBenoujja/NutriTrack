<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'NutriTrack - Profile' }) %>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');
        
        body {
            font-family: 'Manrope', sans-serif;
            background: #f8fafc;
        }
        
        .btn-primary {
            background: #009688;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 150, 136, 0.2);
        }
        
        .btn-primary:hover {
            background: #00786C;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0, 150, 136, 0.4);
        }
        
        .btn-secondary {
            background: #38bdf8;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(56, 189, 248, 0.2);
        }
        
        .btn-secondary:hover {
            background: #0ea5e9;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(56, 189, 248, 0.4);
        }
        
        .card {
            backdrop-filter: blur(20px);
            background: rgba(255, 255, 255, 0.95);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
            border-color: rgba(0, 150, 136, 0.2);
        }
        
        .nav-link {
            transition: all 0.3s ease;
            position: relative;
        }
        
        .nav-link:hover {
            background: rgba(0, 150, 136, 0.1);
            color: #009688;
            transform: translateY(-1px);
        }
        
        .feature-icon {
            color: #009688;
        }
        
        .glass-effect {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .gradient-text {
            color: #009688;
        }
        
        .form-input {
            transition: all 0.3s ease;
        }
        
        .success-message {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 24px;
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
        }

        .profile-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #e5e7eb;
        }

        .edit-btn {
            background: #f3f4f6;
            border: 1px solid #d1d5db;
            color: #374151;
            transition: all 0.2s ease;
        }

        .edit-btn:hover {
            background: #e5e7eb;
            border-color: #9ca3af;
        }

        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(4px);
        }

        .modal-content {
            background-color: white;
            margin: 5% auto;
            padding: 0;
            border-radius: 12px;
            width: 90%;
            max-width: 500px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.25);
            animation: modalSlideIn 0.3s ease-out;
        }

        @keyframes modalSlideIn {
            from {
                opacity: 0;
                transform: translateY(-50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .close {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
        }

        .close:hover {
            color: #000;
        }
    </style>
 </head>
<body class="bg-gray-50">
    <%- include('../partials/navbar', { active: 'profile', user }) %>

    <!-- Main Content -->
    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
        <!-- Header -->
        <div class="mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900 flex items-center">
                        <i class="ri-user-3-line mr-3 text-teal-600"></i>My Profile
                    </h1>
                    <p class="mt-2 text-gray-600">Manage your personal information and health data</p>
                </div>
                <a href="/dashboard" class="btn-primary text-white px-6 py-3 rounded-lg font-medium transition-all duration-300 flex items-center">
                    <i class="ri-arrow-left-line mr-2"></i>Back to Dashboard
                </a>
            </div>
        </div>

        <!-- Success Message -->
        <% if (message) { %>
            <div class="success-message flex items-center">
                <i class="ri-check-line mr-2 text-xl"></i>
                <%= message %>
            </div>
        <% } %>

        <!-- Profile Summary Section -->
        <div class="card rounded-2xl shadow-lg p-6 mb-6">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-4">
                    <div class="relative">
                        <div class="w-20 h-20 bg-teal-500 rounded-full flex items-center justify-center">
                            <i class="ri-user-3-line text-white text-2xl"></i>
                        </div>
                       
                    </div>
                    <div>
                        <h2 class="text-2xl font-bold text-gray-900">
                            <%= (user && user.first_name && user.last_name) ? `${user.first_name} ${user.last_name}` : 'User Name' %>
                </h2>
                        <p class="text-gray-600">
                            <%= user?.profile_type ? user.profile_type.charAt(0).toUpperCase() + user.profile_type.slice(1).replace('_', ' ') : 'Health Enthusiast' %>
                        </p>
                        <p class="text-sm text-gray-500">
                            <%= user?.activity_level ? user.activity_level.charAt(0).toUpperCase() + user.activity_level.slice(1).replace('_', ' ') + ' Activity' : 'Active Lifestyle' %>
                        </p>
                    </div>
                </div>
                <button onclick="openEditModal('profile')" class="edit-btn px-4 py-2 rounded-lg flex items-center">
                    <i class="ri-edit-line mr-2"></i>Edit
                </button>
            </div>
            </div>

        <!-- Personal Information Section -->
        <div class="card rounded-2xl shadow-lg p-6 mb-6">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-xl font-bold text-gray-900">Personal Information</h3>
                <button onclick="openEditModal('personal')" class="edit-btn px-4 py-2 rounded-lg flex items-center">
                    <i class="ri-edit-line mr-2"></i>Edit
                </button>
            </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                    <div>
                        <label class="text-sm text-gray-500">First Name</label>
                        <p class="text-gray-900 font-medium"><%= user?.first_name || 'Not provided' %></p>
                    </div>
                    <div>
                        <label class="text-sm text-gray-500">Birth Date</label>
                        <p class="text-gray-900 font-medium"><%= user?.birth_date ? new Date(user.birth_date).toLocaleDateString() : 'Not provided' %></p>
                    </div>
                    <div>
                        <label class="text-sm text-gray-500">Bio</label>
                        <p class="text-gray-900 font-medium"><%= user?.description || 'No bio provided' %></p>
                    </div>
                </div>
                <div class="space-y-4">
                    <div>
                        <label class="text-sm text-gray-500">Last Name</label>
                        <p class="text-gray-900 font-medium"><%= user?.last_name || 'Not provided' %></p>
                    </div>
                    <div>
                        <label class="text-sm text-gray-500">Profile Type</label>
                        <p class="text-gray-900 font-medium"><%= user?.profile_type ? user.profile_type.charAt(0).toUpperCase() + user.profile_type.slice(1).replace('_', ' ') : 'Not provided' %></p>
                    </div>
                <div>
                        <label class="text-sm text-gray-500">Activity Level</label>
                        <p class="text-gray-900 font-medium"><%= user?.activity_level ? user.activity_level.charAt(0).toUpperCase() + user.activity_level.slice(1).replace('_', ' ') : 'Not provided' %></p>
                    </div>
                </div>
            </div>
                </div>

        <!-- Health Information Section -->
        <div class="card rounded-2xl shadow-lg p-6 mb-6">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-xl font-bold text-gray-900">Health Information</h3>
                <button onclick="openEditModal('health')" class="edit-btn px-4 py-2 rounded-lg flex items-center">
                    <i class="ri-edit-line mr-2"></i>Edit
                </button>
            </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                    <div>
                        <label class="text-sm text-gray-500">Weight</label>
                        <p class="text-gray-900 font-medium"><%= user?.weight ? `${user.weight} kg` : 'Not provided' %></p>
                    </div>
                    <div>
                        <label class="text-sm text-gray-500">Activity Level</label>
                        <p class="text-gray-900 font-medium"><%= user?.activity_level ? user.activity_level.charAt(0).toUpperCase() + user.activity_level.slice(1).replace('_', ' ') : 'Not provided' %></p>
                    </div>
                    <div>
                        <label class="text-sm text-gray-500">Health Conditions</label>
                        <p class="text-gray-900 font-medium"><%= user?.health_conditions || 'None reported' %></p>
                    </div>
                </div>
                <div class="space-y-4">
                    <div>
                        <label class="text-sm text-gray-500">Height</label>
                        <p class="text-gray-900 font-medium"><%= user?.height ? `${user.height} cm` : 'Not provided' %></p>
                    </div>
                    <div>
                        <label class="text-sm text-gray-500">Profile Type</label>
                        <p class="text-gray-900 font-medium"><%= user?.profile_type ? user.profile_type.charAt(0).toUpperCase() + user.profile_type.slice(1).replace('_', ' ') : 'Not provided' %></p>
                    </div>
                    <div>
                        <label class="text-sm text-gray-500">BMI</label>
                        <p class="text-gray-900 font-medium">
                            <% if (user?.weight && user?.height) { %>
                                <%= (user.weight / Math.pow(user.height / 100, 2)).toFixed(1) %>
                            <% } else { %>
                                Not calculated
                            <% } %>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Edit Profile Modal -->
    <div id="editModal" class="modal">
        <div class="modal-content">
            <div class="p-6 border-b border-gray-200">
                <div class="flex items-center justify-between">
                    <h3 id="modalTitle" class="text-xl font-bold text-gray-900">Edit Profile</h3>
                    <span class="close" onclick="closeEditModal()">&times;</span>
                </div>
            </div>
            <form id="editForm" action="/profile" method="post" class="p-6">
                <div id="modalContent">
                    <!-- Content will be dynamically loaded here -->
                </div>
                <div class="flex justify-end space-x-3 pt-4 border-t border-gray-200">
                    <button type="button" onclick="closeEditModal()" class="px-4 py-2 text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
                        Cancel
                    </button>
                    <button type="submit" class="btn-primary text-white px-6 py-2 rounded-lg">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openEditModal(section) {
            const modal = document.getElementById('editModal');
            const modalTitle = document.getElementById('modalTitle');
            const modalContent = document.getElementById('modalContent');
            
            modal.style.display = 'block';
            
            if (section === 'profile') {
                modalTitle.textContent = 'Edit Profile Summary';
                modalContent.innerHTML = `
                    <div class="space-y-4">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">First Name</label>
                                <input type="text" name="first_name" value="<%= user?.first_name || '' %>" class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg focus:border-teal-500 focus:ring-2 focus:ring-teal-200">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Last Name</label>
                                <input type="text" name="last_name" value="<%= user?.last_name || '' %>" class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg focus:border-teal-500 focus:ring-2 focus:ring-teal-200">
                            </div>
                        </div>
                        <!-- Hidden fields to maintain existing values -->
                        <input type="hidden" name="birth_date" value="<%= user?.birth_date ? user.birth_date.toISOString().split('T')[0] : '' %>">
                        <input type="hidden" name="weight" value="<%= user?.weight || '' %>">
                        <input type="hidden" name="height" value="<%= user?.height || '' %>">
                        <input type="hidden" name="activity_level" value="<%= user?.activity_level || '' %>">
                        <input type="hidden" name="health_conditions" value="<%= user?.health_conditions || '' %>">
                        <input type="hidden" name="profile_type" value="<%= user?.profile_type || '' %>">
                        <input type="hidden" name="description" value="<%= user?.description || '' %>">
                    </div>
                `;
            } else if (section === 'personal') {
                modalTitle.textContent = 'Edit Personal Information';
                modalContent.innerHTML = `
                    <div class="space-y-4">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">First Name</label>
                                <input type="text" name="first_name" value="<%= user?.first_name || '' %>" class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg focus:border-teal-500 focus:ring-2 focus:ring-teal-200">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Last Name</label>
                                <input type="text" name="last_name" value="<%= user?.last_name || '' %>" class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg focus:border-teal-500 focus:ring-2 focus:ring-teal-200">
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Birth Date</label>
                            <input type="date" name="birth_date" value="<%= user?.birth_date ? user.birth_date.toISOString().split('T')[0] : '' %>" class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg focus:border-teal-500 focus:ring-2 focus:ring-teal-200">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Bio</label>
                            <textarea name="description" rows="3" class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg focus:border-teal-500 focus:ring-2 focus:ring-teal-200 resize-none"><%= user?.description || '' %></textarea>
                        </div>
                        <!-- Hidden fields to maintain existing values -->
                        <input type="hidden" name="weight" value="<%= user?.weight || '' %>">
                        <input type="hidden" name="height" value="<%= user?.height || '' %>">
                        <input type="hidden" name="activity_level" value="<%= user?.activity_level || '' %>">
                        <input type="hidden" name="health_conditions" value="<%= user?.health_conditions || '' %>">
                        <input type="hidden" name="profile_type" value="<%= user?.profile_type || '' %>">
                    </div>
                `;
            } else if (section === 'health') {
                modalTitle.textContent = 'Edit Health Information';
                modalContent.innerHTML = `
                    <div class="space-y-4">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Weight (kg)</label>
                                <input type="number" name="weight" step="0.1" value="<%= user?.weight || '' %>" class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg focus:border-teal-500 focus:ring-2 focus:ring-teal-200">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Height (cm)</label>
                                <input type="number" name="height" value="<%= user?.height || '' %>" class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg focus:border-teal-500 focus:ring-2 focus:ring-teal-200">
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Activity Level</label>
                            <select name="activity_level" class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg focus:border-teal-500 focus:ring-2 focus:ring-teal-200">
                                <option value="">Select your activity level...</option>
                                <option value="sedentary" <%= user?.activity_level === 'sedentary' ? 'selected' : '' %>>Sedentary - Little to no exercise</option>
                                <option value="light" <%= user?.activity_level === 'light' ? 'selected' : '' %>>Light - Light exercise 1-3 days/week</option>
                                <option value="moderate" <%= user?.activity_level === 'moderate' ? 'selected' : '' %>>Moderate - Moderate exercise 3-5 days/week</option>
                                <option value="active" <%= user?.activity_level === 'active' ? 'selected' : '' %>>Active - Heavy exercise 6-7 days/week</option>
                                <option value="very_active" <%= user?.activity_level === 'very_active' ? 'selected' : '' %>>Very Active - Very heavy exercise, physical job</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Profile Type</label>
                            <select name="profile_type" class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg focus:border-teal-500 focus:ring-2 focus:ring-teal-200">
                                <option value="">Select your profile type...</option>
                                <option value="general" <%= user?.profile_type === 'general' ? 'selected' : '' %>>General Health</option>
                                <option value="weight_loss" <%= user?.profile_type === 'weight_loss' ? 'selected' : '' %>>Weight Loss</option>
                                <option value="athlete" <%= user?.profile_type === 'athlete' ? 'selected' : '' %>>Athlete</option>
                                <option value="diabetes" <%= user?.profile_type === 'diabetes' ? 'selected' : '' %>>Diabetes Management</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Health Conditions</label>
                            <textarea name="health_conditions" rows="3" placeholder="Please describe any health conditions or concerns..." class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg focus:border-teal-500 focus:ring-2 focus:ring-teal-200 resize-none"><%= user?.health_conditions || '' %></textarea>
                        </div>
                        <!-- Hidden fields to maintain existing values -->
                        <input type="hidden" name="first_name" value="<%= user?.first_name || '' %>">
                        <input type="hidden" name="last_name" value="<%= user?.last_name || '' %>">
                        <input type="hidden" name="birth_date" value="<%= user?.birth_date ? user.birth_date.toISOString().split('T')[0] : '' %>">
                        <input type="hidden" name="description" value="<%= user?.description || '' %>">
                    </div>
                `;
            }
        }

        function closeEditModal() {
            document.getElementById('editModal').style.display = 'none';
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            const modal = document.getElementById('editModal');
            if (event.target === modal) {
                closeEditModal();
            }
        }
    </script>
    
    <!-- Toast Notification System -->
    <script src="/js/toast.js"></script>
    <script src="/js/toast-helpers.js"></script>
</body>
</html>