<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NutriTrack - Create Account</title>
    
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/svg+xml" href="/images/favicon-site.svg">
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');
        
        body {
            font-family: 'Manrope', sans-serif;
        }
        
        .input-focus:focus {
            outline: none;
            border-color: #009688;
            box-shadow: 0 0 0 3px rgba(0, 150, 136, 0.1);
        }
        
        .form-group {
            margin-bottom: 1.25rem;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #009688 0%, #00786C 100%);
            transition: all 0.3s ease;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0, 150, 136, 0.3);
        }

        @media (max-width: 1023px) {
            .right-panel {
                display: none;
            }
        }

        /* Enhanced multi-step form styles */
        .step {
            display: none;
            animation: fadeIn 0.4s ease-in-out;
        }
        
        .step.active {
            display: block;
        }
        
        @keyframes fadeIn {
            from { 
                opacity: 0; 
                transform: translateX(20px);
            }
            to { 
                opacity: 1; 
                transform: translateX(0);
            }
        }
        
        .step-indicator {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 2.5rem;
            position: relative;
        }
        
        .step-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            z-index: 10;
        }
        
        .step-circle {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background-color: #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            color: #9ca3af;
            transition: all 0.3s ease;
            border: 3px solid transparent;
        }
        
        .step-circle.active {
            background-color: #009688;
            color: white;
            box-shadow: 0 4px 12px rgba(0, 150, 136, 0.3);
            transform: scale(1.1);
        }
        
        .step-circle.completed {
            background-color: #10b981;
            color: white;
            border-color: #059669;
        }
        
        .step-label {
            margin-top: 0.5rem;
            font-size: 0.75rem;
            font-weight: 600;
            color: #1f2937;
            transition: all 0.3s ease;
            text-align: center;
        }
        
        .step-item.active .step-label {
            color: #1f2937;
            font-weight: 700;
        }
        
        .step-item.completed .step-label {
            color: #1f2937;
        }
        
        .step-line {
            flex: 1;
            height: 3px;
            background-color: #e5e7eb;
            margin: 0 1rem;
            position: relative;
            top: -20px;
            transition: all 0.3s ease;
        }
        
        .step-line.completed {
            background-color: #10b981;
        }
        
        .step-title {
            text-align: center;
            margin-bottom: 2rem;
        }
        
        .step-subtitle {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            color: #6b7280;
            font-size: 0.875rem;
        }
        
        .step-content {
            min-height: 320px;
        }
        
        .progress-bar-container {
            width: 100%;
            height: 6px;
            background-color: #e5e7eb;
            border-radius: 999px;
            margin-bottom: 2rem;
            overflow: hidden;
        }
        
        .progress-bar {
            height: 100%;
            background: linear-gradient(90deg, #009688 0%, #10b981 100%);
            transition: width 0.4s ease;
            border-radius: 999px;
        }
        
        .error-message {
            color: #ef4444;
            font-size: 0.75rem;
            margin-top: 0.25rem;
            display: none;
        }
        
        .error-message.show {
            display: block;
        }
        
        input.error, select.error, textarea.error {
            border-color: #ef4444 !important;
            animation: shake 0.3s ease;
        }
        
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-8px); }
            75% { transform: translateX(8px); }
        }
        
        .right-panel {
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            object-fit: cover;
        }
        
        .tooltip {
            position: relative;
            display: inline-block;
        }
        
        .tooltip .tooltiptext {
            visibility: hidden;
            width: 200px;
            background-color: #1f2937;
            color: #fff;
            text-align: center;
            border-radius: 6px;
            padding: 8px;
            position: absolute;
            z-index: 1;
            bottom: 125%;
            left: 50%;
            margin-left: -100px;
            opacity: 0;
            transition: opacity 0.3s;
            font-size: 0.75rem;
        }
        
        .tooltip:hover .tooltiptext {
            visibility: visible;
            opacity: 1;
        }
    </style>
</head>
<body class="min-h-screen bg-gray-50">
    <div class="flex min-h-screen">
        <!-- Left Side - Form Content -->
        <div class="w-full lg:w-1/2 flex items-center justify-center p-4 sm:p-6 lg:p-12">
            <div class="w-full max-w-md">
                <!-- Logo -->
                <a href="/" class="mb-6 sm:mb-8 flex justify-center md:inline-block mb-6 sm:mb-8">
                    <div class="flex items-center">
                        <img src="/images/logo.svg" alt="NutriTrack Logo" class="h-14 sm:h-14">
                    </div>
                </a>
                
                <!-- Header -->
                <div class="mb-6 sm:mb-8">
                    <h1 class="text-2xl text-center md:text-left sm:text-3xl lg:text-4xl font-bold text-gray-800 mb-2">Create Account</h1>
                    <p class="text-sm sm:text-base text-gray-600 text-center md:text-left">Join NutriTrack and start your health journey</p>
                </div>

                <!-- Progress Bar -->
                <div class="progress-bar-container">
                    <div class="progress-bar" id="progressBar" style="width: 25%"></div>
                </div>

                <!-- Enhanced Step Indicator -->
                <div class="step-indicator">
                    <div class="step-item active" data-step="1">
                        <div class="step-circle">
                            <i class="ri-user-line text-xl"></i>
                        </div>
                        <span class="step-label">Basic Info</span>
                    </div>
                    
                    <div class="step-line" data-line="1"></div>
                    
                    <div class="step-item" data-step="2">
                        <div class="step-circle">
                            <i class="ri-heart-line text-xl"></i>
                        </div>
                        <span class="step-label">Personal</span>
                    </div>
                    
                    <div class="step-line" data-line="2"></div>
                    
                    <div class="step-item" data-step="3">
                        <div class="step-circle">
                            <i class="ri-run-line text-xl"></i>
                        </div>
                        <span class="step-label">Activity</span>
                    </div>
                    
                    <div class="step-line" data-line="3"></div>
                    
                    <div class="step-item" data-step="4">
                        <div class="step-circle">
                            <i class="ri-trophy-line text-xl"></i>
                        </div>
                        <span class="step-label">Goals</span>
                    </div>
                </div>

                <form action="/auth/signup" method="POST" id="signupForm" class="space-y-4">
                    <!-- Step 1: Basic Information -->
                    <div class="step active" id="step1">
                        <div class="step-title">
                            <h2 class="text-xl font-semibold text-gray-800">Basic Information</h2>
                            <div class="step-subtitle">
                                <i class="ri-information-line"></i>
                                <p>Tell us about yourself</p>
                            </div>
                        </div>
                        <div class="step-content">
                            <div class="form-group">
                                <label for="first_name" class="block text-sm font-medium text-gray-700 mb-2">
                                    First Name <span class="text-red-500">*</span>
                                </label>
                                <input 
                                    type="text" 
                                    id="first_name" 
                                    name="first_name" 
                                    class="input-focus w-full px-4 py-3 border border-gray-300 rounded-lg text-gray-800 placeholder-gray-400 transition-all" 
                                    placeholder="John"
                                    required
                                >
                                <span class="error-message" id="first_name_error">Please enter your first name</span>
                            </div>

                            <div class="form-group">
                                <label for="last_name" class="block text-sm font-medium text-gray-700 mb-2">
                                    Last Name <span class="text-red-500">*</span>
                                </label>
                                <input 
                                    type="text" 
                                    id="last_name" 
                                    name="last_name" 
                                    class="input-focus w-full px-4 py-3 border border-gray-300 rounded-lg text-gray-800 placeholder-gray-400 transition-all" 
                                    placeholder="Doe"
                                    required
                                >
                                <span class="error-message" id="last_name_error">Please enter your last name</span>
                            </div>

                            <div class="form-group">
                                <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                                    Email Address <span class="text-red-500">*</span>
                                </label>
                                <input 
                                    type="email" 
                                    id="email" 
                                    name="email" 
                                    class="input-focus w-full px-4 py-3 border border-gray-300 rounded-lg text-gray-800 placeholder-gray-400 transition-all" 
                                    placeholder="john@example.com"
                                    required
                                >
                                <span class="error-message" id="email_error">Please enter a valid email address</span>
                            </div>

                            <div class="form-group">
                                <label for="password" class="block text-sm font-medium text-gray-700 mb-2">
                                    Password <span class="text-red-500">*</span>
                                    <span class="tooltip">
                                        <i class="ri-information-line text-gray-400 ml-1"></i>
                                        <span class="tooltiptext">Password must be at least 8 characters long</span>
                                    </span>
                                </label>
                                <div class="relative">
                                    <input 
                                        type="password" 
                                        id="password" 
                                        name="password" 
                                        class="input-focus w-full px-4 py-3 border border-gray-300 rounded-lg text-gray-800 placeholder-gray-400 transition-all pr-12" 
                                        placeholder="Create a strong password"
                                        required
                                        minlength="8"
                                    >
                                    <button type="button" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-700" onclick="togglePassword('password')">
                                        <i class="ri-eye-line" id="password-icon"></i>
                                    </button>
                                </div>
                                <span class="error-message" id="password_error">Password must be at least 8 characters</span>
                            </div>

                            <div class="form-group">
                                <label for="confirmPassword" class="block text-sm font-medium text-gray-700 mb-2">
                                    Confirm Password <span class="text-red-500">*</span>
                                </label>
                                <div class="relative">
                                    <input 
                                        type="password" 
                                        id="confirmPassword" 
                                        name="confirmPassword" 
                                        class="input-focus w-full px-4 py-3 border border-gray-300 rounded-lg text-gray-800 placeholder-gray-400 transition-all pr-12" 
                                        placeholder="Confirm your password"
                                        required
                                    >
                                    <button type="button" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-700" onclick="togglePassword('confirmPassword')">
                                        <i class="ri-eye-line" id="confirmPassword-icon"></i>
                                    </button>
                                </div>
                                <span class="error-message" id="confirmPassword_error">Passwords do not match</span>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Personal Details -->
                    <div class="step" id="step2">
                        <div class="step-title">
                            <h2 class="text-xl font-semibold text-gray-800">Personal Details</h2>
                            <div class="step-subtitle">
                                <i class="ri-heart-pulse-line"></i>
                                <p>Help us personalize your experience</p>
                            </div>
                        </div>
                        <div class="step-content">
                            <div class="form-group">
                                <label for="birth_date" class="block text-sm font-medium text-gray-700 mb-2">Date of Birth</label>
                                <input 
                                    type="date" 
                                    id="birth_date" 
                                    name="birth_date" 
                                    class="input-focus w-full px-4 py-3 border border-gray-300 rounded-lg text-gray-800 placeholder-gray-400 transition-all" 
                                >
                            </div>

                            <div class="grid grid-cols-2 gap-4">
                                <div class="form-group">
                                    <label for="weight" class="block text-sm font-medium text-gray-700 mb-2">
                                        Weight (kg)
                                    </label>
                                    <div class="relative">
                                        <input 
                                            type="number" 
                                            id="weight" 
                                            name="weight" 
                                            class="input-focus w-full px-4 py-3 border border-gray-300 rounded-lg text-gray-800 placeholder-gray-400 transition-all" 
                                            placeholder="70"
                                            min="1"
                                            max="500"
                                            step="0.1"
                                        >
                                        <span class="absolute right-4 top-1/2 transform -translate-y-1/2 text-gray-400 text-sm">kg</span>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="height" class="block text-sm font-medium text-gray-700 mb-2">
                                        Height (cm)
                                    </label>
                                    <div class="relative">
                                        <input 
                                            type="number" 
                                            id="height" 
                                            name="height" 
                                            class="input-focus w-full px-4 py-3 border border-gray-300 rounded-lg text-gray-800 placeholder-gray-400 transition-all" 
                                            placeholder="175"
                                            min="50"
                                            max="300"
                                        >
                                        <span class="absolute right-4 top-1/2 transform -translate-y-1/2 text-gray-400 text-sm">cm</span>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-teal-50 border border-teal-200 rounded-lg p-4 mt-4">
                                <div class="flex items-start">
                                    <i class="ri-information-line text-teal-600 text-xl mr-3 mt-0.5"></i>
                                    <p class="text-sm text-teal-800">
                                        Your weight and height help us calculate your BMI and provide personalized recommendations.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Activity & Health -->
                    <div class="step" id="step3">
                        <div class="step-title">
                            <h2 class="text-xl font-semibold text-gray-800">Activity & Health</h2>
                            <div class="step-subtitle">
                                <i class="ri-bar-chart-line"></i>
                                <p>Tell us about your lifestyle</p>
                            </div>
                        </div>
                        <div class="step-content">
                            <div class="form-group">
                                <label for="activity_level" class="block text-sm font-medium text-gray-700 mb-2">Activity Level</label>
                                <select 
                                    id="activity_level" 
                                    name="activity_level" 
                                    class="input-focus w-full px-4 py-3 border border-gray-300 rounded-lg text-gray-800 transition-all"
                                >
                                    <option value="">Select your activity level</option>
                                    <option value="sedentary">Sedentary - Little to no exercise</option>
                                    <option value="light">Light - Light exercise 1-3 days/week</option>
                                    <option value="moderate">Moderate - Exercise 3-5 days/week</option>
                                    <option value="active">Active - Hard exercise 6-7 days/week</option>
                                    <option value="very_active">Very Active - Very hard exercise daily</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="health_conditions" class="block text-sm font-medium text-gray-700 mb-2">
                                    Health Conditions
                                    <span class="text-gray-500 text-xs font-normal">(Optional)</span>
                                </label>
                                <textarea 
                                    id="health_conditions" 
                                    name="health_conditions" 
                                    rows="4"
                                    class="input-focus w-full px-4 py-3 border border-gray-300 rounded-lg text-gray-800 placeholder-gray-400 transition-all resize-none" 
                                    placeholder="Any health conditions, allergies, or dietary restrictions..."
                                ></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Step 4: Profile Setup -->
                    <div class="step" id="step4">
                        <div class="step-title">
                            <h2 class="text-xl font-semibold text-gray-800">Complete Your Profile</h2>
                            <div class="step-subtitle">
                                <i class="ri-flag-line"></i>
                                <p>Set your health goals</p>
                            </div>
                        </div>
                        <div class="step-content">
                            <div class="form-group">
                                <label for="profile_type" class="block text-sm font-medium text-gray-700 mb-2">
                                    Profile Type <span class="text-red-500">*</span>
                                </label>
                                <select 
                                    id="profile_type" 
                                    name="profile_type" 
                                    class="input-focus w-full px-4 py-3 border border-gray-300 rounded-lg text-gray-800 transition-all"
                                    required
                                >
                                <option value="">Select your profile type</option>
                                <option value="Diabetes">Diabetes</option>
                                <option value="Athlete">Athlete</option>
                                <option value="Weight Loss">Weight Loss</option>
                                <option value="Maintenance">Maintenance</option>
                                <option value="General">General</option>
                                
                                </select>
                                <span class="error-message" id="profile_type_error">Please select a profile type</span>
                            </div>

                            <div class="form-group">
                                <label for="description" class="block text-sm font-medium text-gray-700 mb-2">
                                    About Your Goals
                                    <span class="text-gray-500 text-xs font-normal">(Optional)</span>
                                </label>
                                <textarea 
                                    id="description" 
                                    name="description" 
                                    rows="4"
                                    class="input-focus w-full px-4 py-3 border border-gray-300 rounded-lg text-gray-800 placeholder-gray-400 transition-all resize-none" 
                                    placeholder="Tell us what you hope to achieve with NutriTrack..."
                                ></textarea>
                            </div>

                            <div class="bg-gradient-to-r from-teal-50 to-green-50 border border-teal-200 rounded-lg p-4 mt-4">
                                <div class="flex items-start">
                                    <i class="ri-check-double-line text-teal-600 text-2xl mr-3"></i>
                                    <div>
                                        <p class="text-sm font-medium text-teal-900 mb-1">Almost there!</p>
                                        <p class="text-xs text-teal-700">
                                            You're one click away from starting your health journey with NutriTrack.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Navigation Buttons -->
                    <div class=" flex gap-3">
                        <button type="button" id="prevBtn" class="flex-1 px-6 py-3 border-2 border-gray-300 rounded-lg text-gray-700 font-medium hover:bg-gray-50 transition-all flex items-center justify-center gap-2" style="display: none;">
                            <i class="ri-arrow-left-line"></i>
                            <span>Previous</span>
                        </button>
                        <button type="button" id="nextBtn" class="flex-1 px-6 py-3 bg-gradient-to-r from-teal-600 to-teal-700 text-white font-medium rounded-lg hover:from-teal-700 hover:to-teal-800 transition-all flex items-center justify-center gap-2 shadow-lg shadow-teal-600/30">
                            <span>Next Step</span>
                            <i class="ri-arrow-right-line"></i>
                        </button>
                        <button type="submit" id="submitBtn" class="flex-1 px-6 py-3 bg-gradient-to-r from-green-600 to-teal-600 text-white font-medium rounded-lg hover:from-green-700 hover:to-teal-700 transition-all flex items-center justify-center gap-2 shadow-lg shadow-green-600/30" style="display: none;">
                            <i class="ri-check-line"></i>
                            <span>Create Account</span>
                        </button>
                    </div>
                </form>

                <div class="mt-6 text-center">
                    <p class="text-gray-600 text-sm">
                        Already have an account? 
                        <a href="/auth/login" class="text-teal-600 hover:text-teal-700 font-semibold">Sign In</a>
                    </p>
                </div>
            </div>
        </div>
        
        <!-- Right Side - Background Image with Quote -->
        <div class="right-panel hidden lg:flex lg:w-1/2 items-center bg-[url('/images/auth.webp')] justify-center p-12 relative rounded-tl-[2.5rem] rounded-bl-[2.5rem] overflow-hidden">
            <!-- Decorative Elements -->
            <div class="absolute top-20 right-20 w-64 h-64 bg-white opacity-10 rounded-full blur-3xl"></div>
            <div class="absolute bottom-20 left-20 w-96 h-96 bg-white opacity-10 rounded-full blur-3xl"></div>
            
            <div class="relative z-10 text-white max-w-lg text-center">
                <i class="ri-double-quotes-l text-6xl opacity-50 mb-6"></i>
                <h2 class="text-4xl lg:text-4xl font-bold mb-6 leading-tight">
                    "Good nutrition is the foundation of a healthy life"
                </h2>
                <p class="text-lg text-white/90 mb-8">
                    Track your eating habits and achieve your goals with NutriTrack
                </p>
                <div class="flex items-center justify-center space-x-8 mt-12">
                    <div class="text-center transform hover:scale-110 transition-transform">
                        <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mb-3 mx-auto backdrop-blur-sm">
                            <i class="ri-camera-lens-line text-3xl"></i>
                        </div>
                        <p class="text-sm opacity-90 font-medium">AI Analysis</p>
                    </div>
                    <div class="text-center transform hover:scale-110 transition-transform">
                        <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mb-3 mx-auto backdrop-blur-sm">
                            <i class="ri-heart-pulse-line text-3xl"></i>
                        </div>
                        <p class="text-sm opacity-90 font-medium">Health Tracking</p>
                    </div>
                    <div class="text-center transform hover:scale-110 transition-transform">
                        <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mb-3 mx-auto backdrop-blur-sm">
                            <i class="ri-line-chart-line text-3xl"></i>
                        </div>
                        <p class="text-sm opacity-90 font-medium">Statistics</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        let currentStep = 1;
        const totalSteps = 4;

        function togglePassword(inputId = 'password') {
            const passwordInput = document.getElementById(inputId);
            const toggleIcon = document.getElementById(inputId + '-icon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('ri-eye-line');
                toggleIcon.classList.add('ri-eye-off-line');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('ri-eye-off-line');
                toggleIcon.classList.add('ri-eye-line');
            }
        }

        function updateProgressBar() {
            const progress = (currentStep / totalSteps) * 100;
            document.getElementById('progressBar').style.width = progress + '%';
        }

        function showStep(step) {
            // Hide all steps
            document.querySelectorAll('.step').forEach(s => s.classList.remove('active'));
            
            // Show current step
            document.getElementById(`step${step}`).classList.add('active');
            
            // Update step indicators
            document.querySelectorAll('.step-item').forEach((item, index) => {
                const stepNum = index + 1;
                const circle = item.querySelector('.step-circle');
                
                item.classList.remove('active', 'completed');
                circle.classList.remove('active', 'completed');
                
                if (stepNum < step) {
                    item.classList.add('completed');
                    circle.classList.add('completed');
                    circle.innerHTML = '<i class="ri-check-line text-xl"></i>';
                } else if (stepNum === step) {
                    item.classList.add('active');
                    circle.classList.add('active');
                    // Set icon based on step
                    if (stepNum === 1) circle.innerHTML = '<i class="ri-user-line text-xl"></i>';
                    else if (stepNum === 2) circle.innerHTML = '<i class="ri-heart-line text-xl"></i>';
                    else if (stepNum === 3) circle.innerHTML = '<i class="ri-run-line text-xl"></i>';
                    else if (stepNum === 4) circle.innerHTML = '<i class="ri-trophy-line text-xl"></i>';
                } else {
                    // Future steps - show number or icon
                    if (stepNum === 1) circle.innerHTML = '<i class="ri-user-line text-xl"></i>';
                    else if (stepNum === 2) circle.innerHTML = '<i class="ri-heart-line text-xl"></i>';
                    else if (stepNum === 3) circle.innerHTML = '<i class="ri-run-line text-xl"></i>';
                    else if (stepNum === 4) circle.innerHTML = '<i class="ri-trophy-line text-xl"></i>';
                }
            });
            
            // Update step lines
            document.querySelectorAll('.step-line').forEach((line, index) => {
                const lineNum = index + 1;
                if (lineNum < step) {
                    line.classList.add('completed');
                } else {
                    line.classList.remove('completed');
                }
            });
            
            // Update navigation buttons
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            const submitBtn = document.getElementById('submitBtn');
            
            if (step === 1) {
                prevBtn.style.display = 'none';
                nextBtn.style.display = 'flex';
                submitBtn.style.display = 'none';
            } else if (step === totalSteps) {
                prevBtn.style.display = 'flex';
                nextBtn.style.display = 'none';
                submitBtn.style.display = 'flex';
            } else {
                prevBtn.style.display = 'flex';
                nextBtn.style.display = 'flex';
                submitBtn.style.display = 'none';
            }
            
            // Update progress bar
            updateProgressBar();
        }

        function showError(fieldId, message) {
            const field = document.getElementById(fieldId);
            const errorElement = document.getElementById(fieldId + '_error');
            
            field.classList.add('error');
            if (errorElement) {
                errorElement.textContent = message;
                errorElement.classList.add('show');
            }
        }

        function hideError(fieldId) {
            const field = document.getElementById(fieldId);
            const errorElement = document.getElementById(fieldId + '_error');
            
            field.classList.remove('error');
            if (errorElement) {
                errorElement.classList.remove('show');
            }
        }

        function validateEmail(email) {
            const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            return re.test(email);
        }

        function validateCurrentStep() {
            const currentStepElement = document.getElementById(`step${currentStep}`);
            const requiredFields = currentStepElement.querySelectorAll('[required]');
            let isValid = true;
            
            // Clear all previous errors
            requiredFields.forEach(field => {
                hideError(field.id);
            });
            
            // Validate each required field
            requiredFields.forEach(field => {
                if (!field.value.trim()) {
                    showError(field.id, `Please enter your ${field.name.replace('_', ' ')}`);
                    isValid = false;
                }
            });
            
            // Special validation for step 1
            if (currentStep === 1) {
                const email = document.getElementById('email').value;
                const password = document.getElementById('password').value;
                const confirmPassword = document.getElementById('confirmPassword').value;
                
                // Email validation
                if (email && !validateEmail(email)) {
                    showError('email', 'Please enter a valid email address');
                    isValid = false;
                }
                
                // Password length validation
                if (password && password.length < 8) {
                    showError('password', 'Password must be at least 8 characters');
                    isValid = false;
                }
                
                // Password match validation
                if (password !== confirmPassword) {
                    showError('confirmPassword', 'Passwords do not match');
                    isValid = false;
                }
            }
            
            // Special validation for step 4
            if (currentStep === 4) {
                const profileType = document.getElementById('profile_type').value;
                if (!profileType) {
                    showError('profile_type', 'Please select a profile type');
                    isValid = false;
                }
            }
            
            return isValid;
        }

        function nextStep() {
            if (validateCurrentStep()) {
                if (currentStep < totalSteps) {
                    currentStep++;
                    showStep(currentStep);
                    // Scroll to top of form
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            }
        }

        function prevStep() {
            if (currentStep > 1) {
                currentStep--;
                showStep(currentStep);
                // Scroll to top of form
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        // Event listeners
        document.getElementById('nextBtn').addEventListener('click', nextStep);
        document.getElementById('prevBtn').addEventListener('click', prevStep);
        
        // Add real-time validation on input
        document.querySelectorAll('input, select, textarea').forEach(field => {
            field.addEventListener('input', function() {
                if (this.classList.contains('error')) {
                    hideError(this.id);
                }
            });
            
            field.addEventListener('blur', function() {
                if (this.hasAttribute('required') && !this.value.trim()) {
                    showError(this.id, `Please enter your ${this.name.replace('_', ' ')}`);
                }
            });
        });
        
        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && e.target.tagName !== 'TEXTAREA') {
                e.preventDefault();
                if (currentStep < totalSteps) {
                    nextStep();
                }
            }
        });
        
        // Initialize form
        document.addEventListener('DOMContentLoaded', function() {
            showStep(1);
        });

        // Form submission
        document.getElementById('signupForm').addEventListener('submit', function(e) {
            if (!validateCurrentStep()) {
                e.preventDefault();
                return false;
            }
        });
    </script>
</body>
</html>